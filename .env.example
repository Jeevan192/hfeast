# ==============================================================================
# CBIT HACKTOBERFEST '26 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server / CORS Configuration
PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://samay-raina-opal.vercel.app

# Frontend API Base URL
# - In local dev with Vite proxy, leave EMPTY ("")
# - In Vercel serverless deployment, leave EMPTY ("")
# - Only set this if you deploy your Express backend on a separate host (e.g. Render / Railway)
VITE_API_URL=

# ==============================================================================
# FIREBASE SERVICE ACCOUNT CREDENTIALS
# (Required for Backend & Firestore database access)
#
# Obtain these from:
# Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
